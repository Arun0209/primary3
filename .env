# ------------------------------------------------------------------
# Primary Infotech — environment configuration
# Copy to ".env" (same folder) OR, preferably, one level ABOVE the web
# root (e.g. /home/USER/.env) so it can never be served over HTTP.
# ------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/primaryinfotech
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hashtag_site
DB_USER=root
DB_PASS=
MAIL_DRIVER=log